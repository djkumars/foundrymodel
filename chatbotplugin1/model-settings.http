@baseUrl = http://localhost:3000
@accessToken = REPLACE_WITH_ADMIN_ACCESS_TOKEN

### Read model settings
GET {{baseUrl}}/api/admin/model-settings
Authorization: Bearer {{accessToken}}

### Set temperature
PUT {{baseUrl}}/api/admin/model-settings
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "temperature": 0.7 }

### Restore model default
PUT {{baseUrl}}/api/admin/model-settings
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{ "temperature": null }
